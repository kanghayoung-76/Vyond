+/// [유일한 디버그 출력] DRAM WGChecker의 상태를 덤프한다.
+/// nslots/errcause/erraddr + HW 슬롯 0..7의 cfg/addr/perm. 슬롯 인덱스가 곧 우선순위이며
+/// (낮을수록 우선), cfg의 하위 2비트 A=0인 슬롯은 RTL(WGCCtrl.scala hit())에서 절대 매치되지
+/// 않으므로 perm 잔재값은 무의미하다. 활성 슬롯(A!=0)의 perm이 전부 0xffff면 "모든 WID가 모든
+/// DRAM 접근" 상태. errcause!=0이면 그때까지 권한 위반이 한 번이라도 있었다는 뜻.
+/// UART가 느리므로(115200) 호출 지점은 run당 1회로 제한해야 한다 — 매 enclave 진입마다 찍으면
+/// 엔트리당 UART 시간이 Linux 틱을 넘겨 enclave가 굶는다(2026-07-28 실측).
+pub(crate) fn dump_dram_slots_at(tag: &[u8], wid: usize) {
+    let dram = crate::wg::WGChecker::new(crate::wg::WGC_DRAM_BASE);
+    sm_mark(b"[WG] ---- DRAM WGChecker dump ----\n\0");
+    sm_mark_hex(tag, wid);            // 예: "[WG] enclave entry wid= 0x1"
+    sm_mark_hex(b"[WG] nslots= ", dram.get_nslots() as usize);
+    sm_mark_hex(b"[WG] errcause= ", dram.get_errcause() as usize);
+    sm_mark_hex(b"[WG] erraddr= ", dram.get_erraddr() as usize);
+    // idx == HW slot (WGC_SLOT_OFFSET=0x40 정정 이후). 8개 슬롯을 필터 없이 전부 찍는다 —
+    // "몇 번 슬롯이 안 열렸나"를 눈으로 바로 확인할 수 있어야 한다. cfg의 A필드(하위 2비트)가
+    // 0이면 그 슬롯은 RTL hit()에서 절대 매치되지 않는 비활성 슬롯이고, perm=0xc000은
+    // 리셋값(WGChecker.scala:147 `perm := 3 << mwid*2`)이다.
+    let mut i = 0usize;
+    while i < 8 {
+        sm_mark_hex(b"[WG]   slot idx= ", i);
+        sm_mark_hex(b"[WG]     cfg= ", dram.get_slot_cfg(i) as usize);
+        sm_mark_hex(b"[WG]     addr= ", dram.get_slot_addr(i) as usize);
+        sm_mark_hex(b"[WG]     perm= ", dram.get_slot_perm(i) as usize);
+        i += 1;
+    }
+    sm_mark(b"[WG] ---- end ----\n\0");
 }
 
